# Store the real file outside Git, chmod 600. Values are literal; no shell code.
DATABENTO_API_KEY=
TAJARI_PAPER_LOCAL_TOKEN=
# Optional authenticated status publisher; no raw market data is transmitted.
TAJARI_PAPER_STATUS_URL=https://tajari.vercel.app/api/paper-service
TAJARI_PAPER_STATUS_TOKEN=

# Server-only Vercel relay settings (do not give Redis credentials to the worker):
# TAJARI_PAPER_RUN_ID=exact-registered-run-id
# KV_REST_API_URL=provided-by-the-real-integration
# KV_REST_API_TOKEN=provided-by-the-real-integration
# Alternatively UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN.
# TAJARI_PAPER_STATUS_TOKEN must match the worker publisher token.
