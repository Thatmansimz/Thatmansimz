# Broker: "paper", "alpaca", "tradovate"
BROKER=paper

# Alpaca (get free keys at alpaca.markets - paper trading is free)
ALPACA_API_KEY=your_key_here
ALPACA_SECRET_KEY=your_secret_here
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# Tradovate (futures, for MES/MNQ)
TRADOVATE_USERNAME=
TRADOVATE_PASSWORD=
TRADOVATE_ACCOUNT_ID=

# Trading Config
SYMBOLS=["MES","MNQ"]
# Stage 2 (live paper) switch. false = engine watches only (no trades).
# true = engine arms on boot and takes paper trades during the NY session.
# You can also flip this at runtime with the "▶ START TRADING" dashboard button
# (POST /api/trading/start) without restarting the backend.
TRADING_ENABLED=false

# Active strategy:
#   "orb"           — V1 Opening Range Breakout (validated, NY session only 9:35–14:00 ET)
#   "multi_session" — V2 Three-session engine (Asia kill zone + London + NY, 24/5)
#                     Backtest: 68 trades / 41.2% WR / PF 1.34 / +$5,127 over 30d MNQ
#                     Switch to this once you're ready to trade all three sessions.
STRATEGY=orb

# Symbols: V1 ORB uses MES+MNQ. V2 multi_session is optimised for MNQ (and NQ).
# For V2, recommended: SYMBOLS=["MNQ"]  (MES doesn't have the same kill-zone moves)
SYMBOLS=["MES","MNQ"]
NEWS_FILTER_ENABLED=true
NEWS_BLACKOUT_PRE_MIN=15
NEWS_BLACKOUT_POST_MIN=15
NEWS_CALENDAR_PATH=data/news_calendar.json

AI_CONFIDENCE_THRESHOLD=0.65
MAX_STOP_LOSS_DOLLARS=250
DAILY_PROFIT_TARGET_DOLLARS=1000
MAX_CONCURRENT_TRADES=3
RISK_PER_TRADE_PERCENT=1.0

# Prop Firm: "none", "apex", "topstep_instant", "traderfi", "myforexfunds"
PROP_FIRM=none
PROP_FIRM_ACCOUNT_SIZE=50000
PROP_FIRM_DAILY_LOSS_LIMIT=2000
PROP_FIRM_MAX_DRAWDOWN=3000
PROP_FIRM_PROFIT_TARGET=3000

# Database
DATABASE_URL=sqlite:///./data/trading.db

# API Settings
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
